<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fullRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF06080B">

    <ImageView
        android:id="@+id/fullBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.34"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/now_playing_full_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="100dp"
        android:paddingEnd="100dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:letterSpacing="0.18"
            android:text="@string/now_playing"
            android:textAllCaps="true"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fullArt"
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:background="@drawable/now_playing_full_art_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/now_playing"
                android:elevation="14dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_weight="1"
                android:background="@drawable/now_playing_full_panel"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingTop="32dp"
                android:paddingEnd="36dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/fullTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:id="@+id/fullArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#B3FFFFFF"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fullElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />

                    <com.gathin.tvhome.WaveformSeekBar
                        android:id="@+id/fullWaveform"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:contentDescription="@string/now_playing" />

                    <TextView
                        android:id="@+id/fullDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/fullPrev"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/now_playing_button_bg"
                        android:contentDescription="@string/previous"
                        android:padding="16dp"
                        android:src="@drawable/ic_previous" />

                    <ImageButton
                        android:id="@+id/fullPlay"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="22dp"
                        android:background="@drawable/now_playing_button_bg"
                        android:contentDescription="@string/pause"
                        android:padding="22dp"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/fullNext"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/now_playing_button_bg"
                        android:contentDescription="@string/next"
                        android:padding="16dp"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/back_to_close"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Last child: the scrim and the panel below must not cover its focus ring. -->
    <ImageButton
        android:id="@+id/fullClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/now_playing_icon_button"
        android:src="@drawable/ic_close"
        android:padding="12dp"
        android:tint="#CCFFFFFF"
        android:elevation="24dp"
        android:contentDescription="@string/close_now_playing" />
</FrameLayout>
