<?xml version="1.0" encoding="utf-8"?>
<com.gathin.tvhome.NowPlayingBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingCard"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:orientation="vertical"
    android:background="@drawable/now_playing_bg_liquid"
    android:clipChildren="true"
    android:outlineProvider="background"
    android:visibility="gone"
    android:focusable="false"
    android:importantForAccessibility="no">

    <FrameLayout
        android:id="@+id/npMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/npEdgeRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/npOpen"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/now_playing">

                <FrameLayout
                    android:id="@+id/npCoverBox"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:clipChildren="false">

                    <FrameLayout
                        android:id="@+id/npArtFrame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/now_playing_cover_left"
                        android:clipChildren="false"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/npArtwork"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/npSourceBadge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_source_badge"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/np_source_badge_label" />

                        <View
                            android:id="@+id/npCoverFocus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/now_playing_cover_focus"
                            android:visibility="invisible"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <com.gathin.tvhome.RadialAuraView
                        android:id="@+id/npAura"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/npTrackInfo"
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/npTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:focusable="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:shadowColor="#AA000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textStyle="bold"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/npSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/npCenter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:id="@+id/npControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/npPrev"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/now_playing_button_bg"
                        android:contentDescription="@string/previous"
                        android:padding="8dp"
                        android:src="@drawable/ic_previous" />

                    <ImageButton
                        android:id="@+id/npPlay"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/now_playing_play_bg"
                        android:contentDescription="@string/pause"
                        android:padding="12dp"
                        android:tint="#FF111318"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/npNext"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/now_playing_button_bg"
                        android:contentDescription="@string/next"
                        android:padding="8dp"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/npActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/npFullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/now_playing_icon_button"
                    android:contentDescription="@string/now_playing_full_label"
                    android:padding="9dp"
                    android:src="@drawable/ic_fullscreen"
                    android:tint="#CCFFFFFF" />

                <ImageButton
                    android:id="@+id/npClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/now_playing_icon_button"
                    android:contentDescription="@string/close_now_playing"
                    android:padding="9dp"
                    android:src="@drawable/ic_close"
                    android:tint="#CCFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Full-width timeline on the bottom edge, over the artwork. -->
        <LinearLayout
            android:id="@+id/npProgress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:background="@drawable/now_playing_progress_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/npElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="monospace"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

            <com.gathin.tvhome.WaveformSeekBar
                android:id="@+id/npWaveform"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:focusable="true"
                android:contentDescription="@string/now_playing" />

            <TextView
                android:id="@+id/npDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</com.gathin.tvhome.NowPlayingBar>
