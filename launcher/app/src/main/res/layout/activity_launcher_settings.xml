<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_scrim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="24dp">

        <!-- Left navigation: the section list, like Glassio's Settings. -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:background="@drawable/settings_panel_plume"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="#FF101419"
                android:textSize="26sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_brand_line"
                android:textAllCaps="true"
                android:textColor="#99000000"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="22dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/navAppearance" style="@style/SettingsNav" android:text="@string/settings_section_appearance" />
                    <TextView android:id="@+id/navBackground" style="@style/SettingsNav" android:text="@string/settings_section_background" />
                    <TextView android:id="@+id/navMotion" style="@style/SettingsNav" android:text="@string/settings_section_motion" />
                    <TextView android:id="@+id/navShelf" style="@style/SettingsNav" android:text="@string/settings_section_shelf" />
                    <TextView android:id="@+id/navNowPlaying" style="@style/SettingsNav" android:text="@string/settings_section_now_playing" />
                    <TextView android:id="@+id/navScreensaver" style="@style/SettingsNav" android:text="@string/settings_section_screensaver" />
                    <TextView android:id="@+id/navSystem" style="@style/SettingsNav" android:text="@string/settings_section_system" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_saved_hint"
                android:textColor="#66000000"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right panel: section title and the settings cards. -->
        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:background="@drawable/settings_panel_plume"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="26dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="INNSTILLINGER"
                android:textAllCaps="true"
                android:textColor="#8C000000"
                android:textSize="11sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/sectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_appearance"
                android:textColor="#FF101419"
                android:textSize="32sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/sectionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/settings_hint_appearance"
                android:textColor="#99000000"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">

                    <!-- ================= Utseende ================= -->
                    <TextView
                        android:id="@+id/sectionAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_appearance"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/columns_label"
                        android:textColor="#FF101419"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                        <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                        <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                        <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/rows_below_dock_label"
                        android:textColor="#FF101419"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                        <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                        <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                        <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/dock_opacity_label"
                        android:textColor="#FF101419"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                        <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                        <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                        <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/dream_name"
                        android:textColor="#FF101419"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                        <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                        <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
                    </LinearLayout>

                    <com.gathin.tvhome.SettingsRow android:id="@+id/clockStyleChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/liquidGlassChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/glassTransparencyChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/iconPackChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/installedIconPackChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/iconGlowChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/glassMotionChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/topBarCapsuleChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/dockGapChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/shelfShadowChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/appNamesChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/heroTitleChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/tileBorderChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/ambientModeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/icon_pack_hint"
                        android:textColor="#99000000"
                        android:textSize="12sp" />

                    <!-- ================= Bakgrunn ================= -->
                    <TextView
                        android:id="@+id/sectionBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_background"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/livingWallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/wallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/mediaBackgroundChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />

                    <!-- ================= Bevegelse ================= -->
                    <TextView
                        android:id="@+id/sectionMotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_motion"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/focusMotionChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/focusGlossChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/editJiggleChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/parallaxChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/animationsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/advanced_effects_warning"
                        android:textColor="#99000000"
                        android:textSize="12sp" />

                    <!-- ================= Topphylle ================= -->
                    <TextView
                        android:id="@+id/sectionShelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_shelf"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/topShelfSourcesChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/topShelfNowPlayingChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/topShelfChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/topShelfProgressChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/topShelfAutoHideChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/smartStackChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/smartStackSecondsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <!-- ================= Nå spiller ================= -->
                    <TextView
                        android:id="@+id/sectionNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_now_playing"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/nowPlayingFullChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npSizeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npWaveformChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npVisualizerChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npTimesChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npAlbumArtChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npSourceBadgeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/npCloseChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />

                    <!-- ================= Skjermsparer ================= -->
                    <TextView
                        android:id="@+id/sectionScreensaver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_screensaver"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/screensaverMediaChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/aerialViewsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/screensaverStatusChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:clickable="false"
                        android:focusable="false" />
                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/screensaverAutoStartChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:clickable="false"
                        android:focusable="false" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/screensaverTestChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/screensaverNotificationChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/screensaverOverlayChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow android:id="@+id/screensaverRestoreChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/screensaverMediaAccessChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp" />
                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/screensaverSleepChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:clickable="false"
                        android:focusable="false" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/screensaver_hint"
                        android:textColor="#99000000"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/screensaver_overlay_unverified"
                        android:textColor="#99000000"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/screensaver_overlay_no_text"
                        android:textColor="#99000000"
                        android:textSize="12sp" />

                    <!-- ================= System ================= -->
                    <TextView
                        android:id="@+id/sectionSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:letterSpacing="0.16"
                        android:text="@string/settings_group_system"
                        android:textAllCaps="true"
                        android:textColor="#99000000"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium" />

                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/reorderChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:text="@string/reorder"
                        android:visibility="gone" />

                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/openOnStartChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <com.gathin.tvhome.SettingsRow android:id="@+id/controlCenterChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />

                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/defaultHomeChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:text="@string/home_settings" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/home_settings_help"
                        android:textColor="#99000000"
                        android:textSize="12sp" />

                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/tvSettingsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp"
                        android:text="@string/tv_settings" />

                    <com.gathin.tvhome.SettingsRow
                        android:id="@+id/followThemeChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="16dp"
                        android:text="@string/follow_theme" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/follow_theme_hint"
                        android:textColor="#99000000"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
